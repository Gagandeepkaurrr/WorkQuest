# For local development, make setup generates valid private values in .env.
APP_ENV=local
APP_ORIGIN=http://localhost:5173
POSTGRES_PASSWORD=replace-with-generated-secret
DATABASE_URL=postgresql+psycopg://workquest:replace-with-generated-secret@localhost:55432/workquest
REDIS_URL=redis://localhost:56379/0
REDIS_NAMESPACE=workquest
DELIVERY_PAYLOAD_ENCRYPTION_KEY=replace-with-fernet-key
DELIVERY_KEY_VERSION=1
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_MAX_AGE_SECONDS=604800
PUBLIC_SIGNUP_ENABLED=true
EMAIL_VERIFICATION_REQUIRED=true
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_FROM=practice@workquest.local
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=none
AI_PROVIDER=local
AI_TIMEOUT_SECONDS=45
AI_USER_DAILY_REQUEST_LIMIT=100
AI_GLOBAL_DAILY_REQUEST_LIMIT=1000
AI_BRANCH_REQUEST_LIMIT=20
DEMO_ENABLED=true
DEMO_TTL_SECONDS=7200
METRICS_TOKEN=replace-with-generated-secret
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
JOB_MAX_AGE_SECONDS=600
